+"""Run the unchanged cross-version regression probes against a supplied 0.31.
+
+No files in the baseline are changed. Expected outcome is assertion failures for
+all twelve probes, zero runtime/import errors. This command succeeds only when
+that expected pre-fix failure set is observed. Use unittest for post-fix tests.
+"""
+
+import argparse
+import importlib.util
+from pathlib import Path
+import sys
+import unittest
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--baseline', type=Path, required=True)
+    args = parser.parse_args()
+    baseline = args.baseline.resolve()
+    if not (baseline / 'cyberforteca' / 'models.py').is_file():
+        parser.error('Expected the original 0.31 project directory')
+    sys.dont_write_bytecode = True
+    sys.path.insert(0, str(baseline))
+    path = Path(__file__).resolve().parents[1] / 'tests' / 'test_regressions.py'
+    spec = importlib.util.spec_from_file_location('pre_fix_regressions', path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    suite = unittest.defaultTestLoader.loadTestsFromModule(module)
+    expected = {test.id() for test in suite._tests[0]}
+    result = unittest.TextTestRunner(verbosity=2).run(suite)
+    failed = {test.id().split(' (')[0] for test, _ in result.failures}
+    print(f'PRE-FIX: {result.testsRun} probes, {len(result.failures)} assertion failures, '
+          f'{len(result.errors)} errors, {len(failed)} distinct probes failing')
+    return 0 if failed == expected and not result.errors else 1
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
