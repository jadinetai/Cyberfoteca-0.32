+"""SMC model and pure in-memory transition simulation. NOT durable storage.
+
+Permanent skeletons and successful purge receipts are append-only. Purge removes
+only cache metadata in the returned immutable state. No sensitive file is read
+or erased here. A real adapter needs transactional storage, key erasure where
+applicable, a protected grant registry, concurrency control, and crash recovery.
+"""
+
+from dataclasses import dataclass, replace
+
+from .models import (
+    AuthorityDecision, AuthorityOutcome, CacheId, Capability, CFDecisionRecord,
+    DecisionSkeleton, DetailCacheEntry, EnforcementResult, Label, Model,
+    PurgeReceipt, Ref, require,
+)
+from .simulation import TrustedSnapshot, validate_grant
+
+
+def decision_skeleton(record: CFDecisionRecord) -> DecisionSkeleton:
+    require(type(record) is CFDecisionRecord, "Validated decision record required")
+    o = record.outcome
+    return DecisionSkeleton(
+        event_id=record.event_id, ledger_epoch=record.ledger_epoch,
+        event_sequence=record.event_sequence, decision_id=o.decision_id,
+        snapshot_digest=o.snapshot_digest,
+        timestamp_unix_ms=record.timestamp_unix_ms, decision=o.decision,
+        requested=o.request.scope, effective=None if o.grant is None else o.grant.scope,
+        session_id=o.request.session_id, key_epoch=record.key_epoch, policy=record.policy,
+        matched_rules=o.matched_rules, reasons=o.reasons,
+        enforcement_point=record.enforcement_point, enforcement_result=record.enforcement_result,
+        build=record.build)
+
+
+@dataclass(frozen=True, kw_only=True)
+class SMCState(Model):
+    ledger_epoch: Ref
+    ledger: tuple[DecisionSkeleton | PurgeReceipt, ...] = ()
+    details: tuple[DetailCacheEntry, ...] = ()
+
+    def __post_init__(self) -> None:
+        super().__post_init__()
+        require(all(e.ledger_epoch == self.ledger_epoch and e.event_sequence == n
+                    for n, e in enumerate(self.ledger, 1)),
+                "Ledger epoch/sequence mismatch")
+        require(len({e.event_id for e in self.ledger}) == len(self.ledger),
+                "Duplicate ledger event")
+        require(len({e.cache_id for e in self.details}) == len(self.details),
+                "Duplicate cache ID")
+        skeleton_events = {e.event_id for e in self.ledger if type(e) is DecisionSkeleton}
+        decisions = [e for e in self.ledger if type(e) is DecisionSkeleton]
+        require(len({e.decision_id for e in decisions}) == len(decisions),
+                "Duplicate decision skeleton")
+        for receipt in (e for e in self.ledger if type(e) is PurgeReceipt):
+            decision = next((d for d in decisions if d.event_id == receipt.decision_event_ref), None)
+            require(decision is not None and decision.event_sequence < receipt.event_sequence and
+                    decision.decision_id == receipt.decision_id and
+                    decision.decision is AuthorityDecision.AUTHORIZED and
+                    decision.effective.capability is Capability.PURGE_OWNED_DETAIL_CACHE and
+                    decision.effective.resource == receipt.resource and
+                    decision.session_id == receipt.session_id and
+                    decision.key_epoch == receipt.key_epoch and decision.policy == receipt.policy,
+                    "Purge receipt must follow its matching decision")
+        require(all(d.decision_event_ref in skeleton_events for d in self.details),
+                "Cache details require a permanent decision skeleton")
+
+
+def append_decision(state: SMCState, record: CFDecisionRecord) -> SMCState:
+    # Creating a new state validates epoch, unique event ID and monotonic sequence.
+    return replace(state, ledger=state.ledger + (decision_skeleton(record),))
+
+
+def purge_detail_cache(*, state: SMCState, outcome: AuthorityOutcome,
+                       context: TrustedSnapshot, cache_id: CacheId,
+                       event_id: Ref, timestamp_unix_ms: int) -> tuple[SMCState, PurgeReceipt]:
+    """Atomic-by-value simulation: failure returns no new state and no receipt.
+
+    The successful receipt says EXECUTED at SIMULATION.SMC.CACHE, not that real
