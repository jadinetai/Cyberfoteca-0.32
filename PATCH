+"""Generate a reviewable baseline diff and deterministic source release archive."""
+
+import argparse
+import difflib
+from pathlib import Path
+import zipfile
+
+
+EXCLUDED = {'__pycache__', 'CHANGES_031_TO_032.patch', 'TEST_RESULTS.txt'}
+
+
+def files(root):
+    return {p.relative_to(root): p for p in root.rglob('*')
+            if p.is_file() and not any(part in EXCLUDED for part in p.parts)
+            and p.suffix != '.pyc'}
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--baseline', type=Path, required=True)
+    parser.add_argument('--output', type=Path, required=True)
+    args = parser.parse_args()
+    root = Path(__file__).resolve().parents[1]
+    baseline = args.baseline.resolve()
+    if not (baseline / 'cyberforteca' / 'models.py').is_file():
+        parser.error('Expected original 0.31 project directory')
+    before, after = files(baseline), files(root)
+    changes = []
+    for name in sorted(before.keys() | after.keys()):
+        old = before[name].read_text(encoding='ascii').splitlines(keepends=True) if name in before else []
+        new = after[name].read_text(encoding='ascii').splitlines(keepends=True) if name in after else []
+        changes.extend(difflib.unified_diff(old, new, fromfile='a/' + str(name),
+                                            tofile='b/' + str(name)))
+    (root / 'CHANGES_031_TO_032.patch').write_text(''.join(changes), encoding='ascii')
+    output = args.output.resolve()
+    with zipfile.ZipFile(output, 'w', compression=zipfile.ZIP_DEFLATED) as archive:
+        for path in sorted(root.rglob('*')):
+            if not path.is_file() or '__pycache__' in path.parts or path.suffix == '.pyc':
+                continue
+            info = zipfile.ZipInfo('cyberforteca-0.32/' + path.relative_to(root).as_posix(),
+                                   date_time=(2026, 10, 1, 0, 0, 0))
+            info.compress_type = zipfile.ZIP_DEFLATED
+            info.external_attr = 0o100644 << 16
+            archive.writestr(info, path.read_bytes())
+    print(output)
+    print(f'{output.stat().st_size} bytes')
+
+
+if __name__ == '__main__':
+    main()
