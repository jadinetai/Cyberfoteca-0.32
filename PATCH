+"""Remove each trust-check side in isolated copies. No live source is edited.
+
+Each mutant runs a targeted status test with all unrelated prerequisites valid.
+Only an assertion failure with zero errors counts as killed. Then the full
+parametrized binding/freshness suite remains available via unittest discover.
+This is targeted mutation evidence, not a comprehensive mutation score.
+"""
+
+import ast
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+import tempfile
+
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def without_side(source, variable, side):
+    tree = ast.parse(source)
+    loops = [n for n in ast.walk(tree) if isinstance(n, ast.For)
+             and isinstance(n.target, ast.Tuple)
+             and isinstance(n.target.elts[0], ast.Name)
+             and n.target.elts[0].id == variable]
+    if len(loops) != 1 or not isinstance(loops[0].iter, ast.Tuple):
+        raise RuntimeError('Unexpected check-loop structure')
+    item = loops[0].iter.elts[0 if side == 'local' else 1]
+    first = item.elts[0]
+    if not isinstance(first, ast.Attribute) or first.attr != side + '_' + (
+            'identity' if variable == 'identity' else 'attestation'):
+        raise RuntimeError('Unexpected trust-check subject')
+    lines = source.splitlines(keepends=True)
+    start = sum(map(len, lines[:item.lineno - 1])) + item.col_offset
+    end = sum(map(len, lines[:item.end_lineno - 1])) + item.end_col_offset
+    # Both tuple entries have a trailing comma. Remove only this side's entry.
+    if source[end] != ',':
+        raise RuntimeError('Unexpected trust-check tuple punctuation')
+    mutated = source[:start] + source[end + 1:]
+    compile(mutated, '<mutant>', 'exec')
+    return mutated
+
+
+def main():
+    source = (ROOT / 'cyberforteca' / 'simulation.py').read_text(encoding='ascii')
+    passed = 0
+    for kind, variable in (('identity', 'identity'), ('attestation', 'att')):
+        for side in ('local', 'peer'):
+            with tempfile.TemporaryDirectory(prefix='cf032-mutation-') as directory:
+                target = Path(directory) / 'project'
+                shutil.copytree(ROOT, target, ignore=shutil.ignore_patterns('__pycache__', '*.pyc'))
+                # Bulk mechanical mutation of an isolated disposable source copy.
+                (target / 'cyberforteca' / 'simulation.py').write_text(
+                    without_side(source, variable, side), encoding='ascii')
+                test = 'tests.test_hardening.HardeningTests.test_local_and_peer_' + kind + '_status_checks'
+                run = subprocess.run([sys.executable, '-B', '-m', 'unittest', test, '-v'],
+                                     cwd=target, text=True, capture_output=True)
+                output = run.stdout + run.stderr
+                killed = (run.returncode == 1 and 'FAILED (failures=' in output
+                          and 'errors=' not in output and "side='" + side + '_' + kind + "'" in output)
+                print(f'{side}.{kind}: {"KILLED" if killed else "NOT KILLED"}')
+                print(output, end='')
+                passed += int(killed)
+    print(f'Targeted trust-side mutants killed: {passed}/4')
+    return 0 if passed == 4 else 1
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
